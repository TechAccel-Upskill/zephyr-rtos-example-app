# This file is the application Kconfig entry point. All application Kconfig
# options can be defined here or included via other application Kconfig files.
# You can browse these options using the west targets menuconfig (terminal) or
# guiconfig (GUI).

menu "Zephyr"
source "Kconfig.zephyr"
endmenu

module = APP
module-str = APP
source "subsys/logging/Kconfig.template.log_config"

config APP_SAMPLE_PERIOD_MS
	int "Safety monitor sample period (ms)"
	default 100
	range 1 60000

config APP_WARNING_SAMPLES
	int "Valid hazard samples before warning"
	default 2
	range 1 255

config APP_EMERGENCY_SAMPLES
	int "Valid hazard samples before emergency"
	default 5
	range APP_WARNING_SAMPLES 255

config APP_FAULT_SAMPLES
	int "Invalid samples before sensor fault"
	default 3
	range 1 255

config APP_RESOURCE_MONITOR
	bool "Periodic CPU/stack resource reporting"
	select THREAD_ANALYZER
	select THREAD_NAME
	select THREAD_RUNTIME_STATS
	default y
	help
	  Periodically logs per-thread CPU load and stack usage using
	  Zephyr's thread analyzer subsystem, alongside a bare-metal
	  interrupt-mask read implemented in inline assembly.

config APP_RESOURCE_MONITOR_PERIOD_MS
	int "Resource report period (ms)"
	default 5000
	range 100 3600000
	depends on APP_RESOURCE_MONITOR
